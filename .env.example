CLICKQUOTA_HOST=127.0.0.1
CLICKQUOTA_PORT=4310
# Set a private key before exposing ClickQuota beyond loopback.
CLICKQUOTA_API_KEY=
# Optional master admin password for Admin UI (timing-safe compare, NEVER hardcode in source).
# Leave empty to disable the master-password auth path entirely.
CLICKQUOTA_MASTER_PASSWORD=

# Telegram alerting (optional). Leave empty to disable silently.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Health digest interval in hours: 12 or 24 (default 24).
CLICKQUOTA_TELEGRAM_DIGEST_HOURS=24

# Muse2API Integration (optional, defaults to 127.0.0.1:18610)
MUSE_BASE_URL=http://127.0.0.1:18610
# Leave empty to send no Authorization header (loopback muse2api without auth).
MUSE_API_KEY=
